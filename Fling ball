import pygame import math import sys import random # Initialize Pygame pygame.init() # --- Configuration & Constants --- WIDTH, HEIGHT = 800, 600 # Normalized VIRTUAL_HEIGHT to a manageable size (10 km) to prevent float precision errors VIRTUAL_HEIGHT = 10000.0 SCREEN = pygame.display.set_mode((WIDTH, HEIGHT)) pygame.display.set_caption("Pygame Golf Upgrades - Space Odyssey") font = pygame.font.Font(None, 36) small_font = pygame.font.Font(None, 24) # Colors WHITE = (255, 255, 255) GREEN = (0, 150, 0) SKY_BLUE = (135, 206, 235) RED = (255, 0, 0) BLACK = (0, 0, 0) YELLOW = (255, 255, 0) MARS_RED = (200, 100, 50) SPACE_BLACK = (10, 10, 10) AIM_LINE_COLOR = (255, 255, 255) # Thematic Heights (virtual meters from ground) SPACE_START_HEIGHT = 1000.0 MARS_START_HEIGHT = 3000.0 # Physics Constants (These will be modified by upgrades) BASE_GRAVITY = 0.5 # Increased gravity for faster falls BASE_POWER_MULTIPLIER = 0.4 # Increased power for longer shots BASE_DURABILITY_METERS = 50.0 FPS = 60 clock = pygame.time.Clock() # --- Game State Variables --- ball_pos_virtual = pygame.Vector2(100, float(VIRTUAL_HEIGHT - 50)) ball_vel_virtual = pygame.Vector2(0, 0) is_aiming = False shot_launched = False mouse_start_pos = None camera_offset_y = float(VIRTUAL_HEIGHT - HEIGHT) # Start camera at ground level # Score Variables current_score = 0 max_height_reached_y = ball_pos_virtual.y # --- Player Stats and Upgrades (Mockup for non-Replit DB use) --- def load_player_data(): data = {} data["coins"] = 0 data["high_score"] = 0 data["strength_level"] = 0 data["speed_level"] = 0 data["durability_level"] = 0 return data player = load_player_data() def save_player_data(): pass def get_upgrade_cost(level): # Simplified cost calculation for new VIRTUAL_HEIGHT return 50 + (level ** 2) * 25 def buy_upgrade(attribute): current_level = player[f"{attribute}_level"] cost = get_upgrade_cost(current_level + 1) if player["coins"] >= cost: player["coins"] -= cost player[f"{attribute}_level"] += 1 print(f"Upgraded {attribute} to Level {player[f'{attribute}_level']}!") return True else: print(f"Not enough coins to buy {attribute} upgrade. Need {cost}.") return False # --- World Objects (Platforms) --- class Platform: def __init__(self, x, y, width, height, color): self.rect = pygame.Rect(x, y, width, height) self.color = color platforms = [] GROUND_Y_VIRTUAL = VIRTUAL_HEIGHT - 50 for i in range(20): y = GROUND_Y_VIRTUAL - random.randint(100, int(SPACE_START_HEIGHT - 10)) x = random.randint(0, WIDTH - 50) platforms.append(Platform(x, y, 60, 20, WHITE)) for i in range(20): y = GROUND_Y_VIRTUAL - random.randint(int(SPACE_START_HEIGHT), int(MARS_START_HEIGHT - 50)) x = random.randint(0, WIDTH - 50) platforms.append(Platform(x, y, 40, 40, MARS_RED)) for i in range(20): y = GROUND_Y_VIRTUAL - random.randint(int(MARS_START_HEIGHT), int(MARS_START_HEIGHT + 500)) x = random.randint(0, WIDTH - 50) platforms.append(Platform(x, y, 80, 30, GREEN)) # --- Drawing and Camera Functions --- def virtual_to_screen(virtual_y_pos): return virtual_y_pos - camera_offset_y def draw_background_and_theme(): current_middle_y = camera_offset_y + HEIGHT / 2 space_y_virtual = VIRTUAL_HEIGHT - SPACE_START_HEIGHT mars_y_virtual = VIRTUAL_HEIGHT - MARS_START_HEIGHT theme_name = "Earth" if current_middle_y < mars_y_virtual: SCREEN.fill(MARS_RED) theme_name = "Mars" elif current_middle_y < space_y_virtual: SCREEN.fill(SPACE_BLACK) theme_name = "Space" else: SCREEN.fill(SKY_BLUE) theme_name = "Earth" for platform in platforms: screen_y = virtual_to_screen(platform.rect.y) if screen_y < HEIGHT and screen_y > -platform.rect.height: pygame.draw.rect(SCREEN, platform.color, (platform.rect.x, screen_y, platform.rect.width, platform.rect.height)) ground_y_screen = virtual_to_screen(VIRTUAL_HEIGHT - 50) pygame.draw.rect(SCREEN, GREEN, (0, ground_y_screen, WIDTH, 100)) return theme_name def draw_ball(): screen_y = virtual_to_screen(ball_pos_virtual.y) if screen_y > -20 and screen_y < HEIGHT + 20: pygame.draw.circle(SCREEN, WHITE, (int(ball_pos_virtual.x), int(screen_y)), 10) def display_ui(theme_name): # Ensure text color contrasts with background color dynamically text_color = WHITE if theme_name == "Space" or theme_name == "Mars" else BLACK score_text = font.render(f"Coins: {player['coins']} (Run: {current_score})", True, text_color) theme_text = font.render(f"Zone: {theme_name}", True, text_color) SCREEN.blit(score_text, (10, 10)) SCREEN.blit(theme_text, (10, 40)) # Function to display upgrade options (moved outside game loop) def display_upgrades(player_data, screen_width, theme_name): text_color = WHITE if theme_name == "Space" or theme_name == "Mars" else BLACK y_offset = 80 upgrades = [("strength", "Strength (1)", "Boosts shot power"), ("speed", "Speed (2)", "Increases max velocity"), ("durability", "Durability (3)", "Increases impact tolerance")] for attr, key_text, desc in upgrades: level = player_data[f"{attr}_level"] cost = get_upgrade_cost(level + 1) level_text = small_font.render(f"{key_text} Lvl: {level}", True, text_color) cost_text = small_font.render(f"Cost: {cost} coins", True, text_color) SCREEN.blit(level_text, (screen_width - 250, y_offset)) SCREEN.blit(cost_text, (screen_width - 250, y_offset + 20)) y_offset += 40 def update_camera(): global camera_offset_y target_offset = ball_pos_virtual.y - HEIGHT / 2 camera_offset_y += (target_offset - camera_offset_y) * 0.05 max_offset = VIRTUAL_HEIGHT - HEIGHT camera_offset_y = max(0.0, min(float(max_offset), float(camera_offset_y))) def reset_ball_to_start(): global ball_pos_virtual, ball_vel_virtual, shot_launched, current_score, max_height_reached_y, camera_offset_y if current_score > player['high_score']: player['high_score'] = current_score save_player_data() ball_pos_virtual = pygame.Vector2(100, float(VIRTUAL_HEIGHT - 50)) ball_vel_virtual = pygame.Vector2(0, 0) shot_launched = False current_score = 0 max_height_reached_y = ball_pos_virtual.y camera_offset_y = float(VIRTUAL_HEIGHT - HEIGHT) # --- Main Game Loop --- def game_loop(): global is_aiming, ball_vel_virtual, shot_launched, mouse_start_pos, max_height_reached_y, current_score, player, camera_offset_y reset_button_rect = pygame.Rect(WIDTH - 120, 10, 100, 30) while True: # Calculate Delta Time dt = clock.tick(FPS) / 1000.0 * 60 # Delta time scaled to 60 FPS for consistent feel # --- 1. Handle Events (Input) --- for event in pygame.event.get(): if event.type == pygame.QUIT: pygame.quit() sys.exit() if event.type == pygame.KEYDOWN: if event.key == pygame.K_r: reset_ball_to_start() if event.key == pygame.K_1: buy_upgrade("strength") if event.key == pygame.K_2: buy_upgrade("speed") if event.key == pygame.K_3: buy_upgrade("durability") if event.type == pygame.MOUSEBUTTONDOWN: if reset_button_rect.collidepoint(event.pos): reset_ball_to_start() # Allow aiming only if the ball is completely stopped elif ball_vel_virtual.length() == 0: is_aiming = True # Store mouse position as a Vector2 to prevent type errors later mouse_start_pos = pygame.Vector2(event.pos) if event.type == pygame.MOUSEBUTTONUP: if is_aiming and mouse_start_pos is not None: is_aiming = False mouse_end_pos = pygame.Vector2(event.pos) actual_power_multiplier = BASE_POWER_MULTIPLIER + (player['strength_level'] * 0.05) speed_bonus_factor = 1 + (player['speed_level'] * 0.1) # Calculate velocity vector (end - start position = direction) direction_vector = mouse_start_pos - mouse_end_pos ball_vel_virtual.x = direction_vector.x * actual_power_multiplier * speed_bonus_factor ball_vel_virtual.y = direction_vector.y * actual_power_multiplier shot_launched = True max_height_reached_y = ball_pos_virtual.y mouse_start_pos = None # --- 2. Update Game State (Physics & Scoring) --- if shot_launched: durability_limit_height = BASE_DURABILITY_METERS * (1 + player['durability_level']) durability_limit_y = VIRTUAL_HEIGHT - durability_limit_height if ball_pos_virtual.y < durability_limit_y: # Penalize only once when crossing the line if ball_vel_virtual.length() > 0: player['coins'] = max(0, player['coins'] - 50) ball_vel_virtual = pygame.Vector2(0, 0) else: ball_vel_virtual.y += BASE_GRAVITY * dt # Use DT ball_rect_virtual = pygame.Rect(ball_pos_virtual.x - 10, ball_pos_virtual.y - 10, 20, 20) for platform in platforms: if ball_rect_virtual.colliderect(platform.rect): if ball_vel_virtual.y > 0 and ball_pos_virtual.y < platform.rect.top + 10: ball_pos_virtual.y = platform.rect.top - 10 ball_vel_virtual.y = 0 ball_vel_virtual.x *= 0.9 if abs(ball_vel_virtual.x) < 0.1: ball_vel_virtual.x = 0 ball_pos_virtual += ball_vel_virtual * dt # Use DT # Wall collisions (simplified, no DT needed for instant position/velocity flips) if ball_pos_virtual.x < 10: ball_pos_virtual.x = 10 ball_vel_virtual.x *= -0.5 if ball_pos_virtual.x > WIDTH - 10: ball_pos_virtual.x = WIDTH - 10 ball_vel_virtual.x *= -0.5 # Scoring logic (simplified scoring occurs here based on max height) if ball_pos_virtual.y < max_height_reached_y: height_gained = max_height_reached_y - ball_pos_virtual.y player['coins'] += int(height_gained * 0.1) current_score += int(height_gained) max_height_reached_y = ball_pos_virtual.y # Ground Collision if ball_pos_virtual.y >= VIRTUAL_HEIGHT - 50: ball_pos_virtual.y = float(VIRTUAL_HEIGHT - 50) ball_vel_virtual.y = 0 ball_vel_virtual.x *= 0.85 # Stop completely if nearly still on the ground if abs(ball_vel_virtual.x) < 0.1 and abs(ball_vel_virtual.y) < 0.1: ball_vel_virtual.x = 0 ball_vel_virtual.y = 0 update_camera() # --- 3. Draw Everything --- theme_name = draw_background_and_theme() # Draw the aiming line if aiming if is_aiming and mouse_start_pos is not None: current_mouse_pos = pygame.mouse.get_pos() ball_screen_pos = (int(ball_pos_virtual.x), int(virtual_to_screen(ball_pos_virtual.y))) pygame.draw.line(SCREEN, AIM_LINE_COLOR, ball_screen_pos, current_mouse_pos, 5) draw_ball() display_ui(theme_name) display_upgrades(player, WIDTH, theme_name) # Display upgrade list pygame.draw.rect(SCREEN, RED, reset_button_rect) reset_text = small_font.render("Reset (R)", True, WHITE) text_rect = reset_text.get_rect(center=reset_button_rect.center) SCREEN.blit(reset_text, text_rect) # Display instructions/status status_text = "" if ball_vel_virtual.length() == 0: status_text = "Click/drag FROM the ball to aim. Use 1,2,3 for upgrades." durability_limit_height = BASE_DURABILITY_METERS * (1 + player['durability_level']) durability_limit_y = VIRTUAL_HEIGHT - durability_limit_height if ball_pos_virtual.y < durability_limit_y and shot_launched: status_text = "Ball broke! Use Reset Button to restart." if status_text: text_color = WHITE if theme_name == "Space" or theme_name == "Mars" else BLACK text_surf = small_font.render(status_text, True, text_color) SCREEN.blit(text_surf, (WIDTH // 2 - text_surf.get_width() // 2, HEIGHT - 30)) # Update the display pygame.display.flip() # clock.tick(FPS) is now used at the top for dt calculation if __name__ == "__main__": game_loop()
